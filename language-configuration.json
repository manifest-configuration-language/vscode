{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": ["string"]
    }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:export\\s+)?(?:let|fn)\\b[^#]*=|.*:)\\s*(?:#.*)?$",
    "decreaseIndentPattern": "^\\s*(?:\\}|\\]|else\\s*:)"
  },
  "wordPattern": "[\\p{L}_][\\p{L}\\p{N}_]*"
}
