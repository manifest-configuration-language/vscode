{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>walnuts1018/renovate-config"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^mcl-cli-version\\.json$/"],
      "matchStrings": ["\"tag\"\\s*:\\s*\"(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "manifest-configuration-language/mcl",
      "packageNameTemplate": "manifest-configuration-language/mcl",
      "datasourceTemplate": "github-releases"
    }
  ]
}
